    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СтатусыЗаказовСрезПоследних.РезультатДоставки КАК РезультатДоставки,
	СтатусыЗаказовСрезПоследних.Заказ.СуммаСтоимостьТоваровЗаказа +
		СтатусыЗаказовСрезПоследних.Заказ.СтоимостьДоставки КАК Сумма,
	СтатусыЗаказовСрезПоследних.Заказ.ТипОплаты КАК ТипОплаты,
	СтатусыЗаказовСрезПоследних.Заказ.Ссылка КАК ЗаказСсылка
ПОМЕСТИТЬ ВТ_Заказы
ИЗ
	РегистрСведений.СтатусыЗаказов.СрезПоследних(, Рейс = &amp;ВыбранныйРейс) КАК СтатусыЗаказовСрезПоследних
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_Заказы.ЗаказСсылка) КАК Количество,
	ВТ_Заказы.РезультатДоставки КАК РезультатДоставки,
	СУММА(ВТ_Заказы.Сумма) КАК Сумма,
	ВТ_Заказы.ТипОплаты КАК ТипОплаты
ИЗ
	ВТ_Заказы КАК ВТ_Заказы
СГРУППИРОВАТЬ ПО
	ВТ_Заказы.РезультатДоставки,
	ВТ_Заказы.ТипОплаты</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
