#Область ПрограммныйИнтерфейс
// Закрытие формы авторизации.
// 
// Параметры:
//  Результат - Структура - Результат
//  ДополнительныеПараметры - Структура -  Дополнительные параметры
Процедура ЗакрытиеФормыАвторизации(Результат, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Если Результат.РезультатАвторизации <> "Успешно" Тогда
			ЗавершитьРаботуСистемы(Ложь);
		КонецеСли;	
	КонецеСли;	
КонецПроцедуры
#КонецОбласти