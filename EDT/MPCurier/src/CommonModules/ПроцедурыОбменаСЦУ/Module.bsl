Функция ВыполнитьОбмен_УстановитьПараметрыМПВЦУ(ОбщееСоединениеHTTP = "", IDУзла) Экспорт
	Попытка
		СтруктураВызова = Новый Структура();
		
		СтруктураПараметрШаблон = Новый ФиксированнаяСтруктура("name, value");
		МассивПараметров	 = Новый Массив;
		
		ВерсияКонфигурации = Метаданные.Версия;
		Если Не ЗначениеЗаполнено(ВерсияКонфигурации) Тогда
			ВерсияКонфигурации = "1.0.0.1";
		КонецеСли;
		
		ОписаниеВерсии = ОбщегоНазначенияСервер.ПолучитьОписаниеВерсииИзМакетаВерсий(ВерсияКонфигурации);
		
		НовыйПараметр = Новый Структура(СтруктураПараметрШаблон);
		НовыйПараметр.name = "MA_VersionDescr";
		НовыйПараметр.value = ОписаниеВерсии.Описание;
		МассивПараметров.Добавить(НовыйПараметр);
		
		НовыйПараметр = Новый Структура(СтруктураПараметрШаблон);
		НовыйПараметр.name = "MA_VersionFinal";
		НовыйПараметр.value = ОписаниеВерсии.ЭтоРелизнаяВерсия;
		МассивПараметров.Добавить(НовыйПараметр);
		
		
		НовыйПараметр = Новый Структура(СтруктураПараметрШаблон);
		НовыйПараметр.name = "MA_Version";
		НовыйПараметр.value = ВерсияКонфигурации;
		МассивПараметров.Добавить(НовыйПараметр);
		
		
		НовыйПараметр = Новый Структура(СтруктураПараметрШаблон);
		НовыйПараметр.name = "routeMapVersion";
		НовыйПараметр.value = Константы.ВерсияСтраницыМаршрутизации.Получить();
		МассивПараметров.Добавить(НовыйПараметр);
	
		// TODO: реализовать прием IDПодписчикаPushУведомлений в УТ	
		СтрокаIDПодписчикаPushУведомлений = "";	
		ЗначениеIDПодписчикаPushУведомлений = Константы.IDПодписчикаPushУведомлений.Получить();
		Если ЗначениеЗаполнено(ЗначениеIDПодписчикаPushУведомлений) Тогда
			ОбъектXDTO = СериализаторXDTO.ЗаписатьXDTO(ЗначениеIDПодписчикаPushУведомлений);
			ЗаписьПримерXML = Новый ЗаписьXML;
			ЗаписьПримерXML.УстановитьСтроку();
			ФабрикаXDTO.ЗаписатьXML(ЗаписьПримерXML, ОбъектXDTO);
			
			СтрокаIDПодписчикаPushУведомлений = ЗаписьПримерXML.Закрыть();
		Иначе
			СтрокаIDПодписчикаPushУведомлений = "";
		КонецеСли;		
		НовыйПараметр = Новый Структура(СтруктураПараметрШаблон);
		НовыйПараметр.name = "idNotificationSuscriber";
		НовыйПараметр.value = СтрокаIDПодписчикаPushУведомлений;
		МассивПараметров.Добавить(НовыйПараметр);
		
		
		//а когда транспорт еще не привязан?
		НовыйПараметр = Новый Структура(СтруктураПараметрШаблон);
		НовыйПараметр.name = "car_id";
		ТранспортМП = Константы.ТранспортМП.Получить();
		Если ЗначениеЗаполнено(ТранспортМП) Тогда
			НовыйПараметр.value = ТранспортМП.Код;
		Иначе
			НовыйПараметр.value = "";	
		КонецеСли;		
		МассивПараметров.Добавить(НовыйПараметр);
		
		СтруктураВызова.Вставить("ID", СокрЛП(IDУзла));
		СтруктураВызова.Вставить("arrayOfParameters", МассивПараметров);
		
		СтрокаJSON = СформироватьСтрокуJSON(СтруктураВызова);
		
		ОтветМетода = Новый Структура;	
	
		РезультатВызова = ВызватьФункциюHTTPСервиса(СтрокаJSON, "setParameters", ОбщееСоединениеHTTP);
		
		ВозниклаОшибка = Ложь;
		ДанныеВызова = ДанныеJSONВСтруктуру(РезультатВызова, , ВозниклаОшибка);
		Если ВозниклаОшибка Тогда
			ОтветМетода.Вставить("РезультатВызова", Ложь);
			ОтветМетода.Вставить("ОписаниеОшибки", "Возникла ошибка при вызове setParameters!");
			Возврат ОтветМетода;
		КонецеСли;	
	Исключение
		ОтветМетода.Вставить("РезультатВызова", Ложь);
		ОтветМетода.Вставить("ОписаниеОшибки", "Возникла ошибка при вызове setParameters!");
		Возврат ОтветМетода;		
	КонецПопытки;	
	ОтветМетода.Вставить("РезультатВызова", ДанныеВызова.result);
	ОтветМетода.Вставить("ОписаниеОшибки", ДанныеВызова.errorText);
	Возврат ОтветМетода;	
КонецФункции


