		ОтветМетода.Вставить("НомерРейсаНаСегодня", "");
		Возврат ОтветМетода;
	КонецеСли;		
	
	СтрокаJSON = СформироватьСтрокуJSON(СтруктураВызова);
	
	Попытка			
		РезультатВызова = ВызватьФункциюHTTPСервиса(СтрокаJSON, "getTrips", ОбщееСоединениеHTTP);
		
		ВозниклаОшибка = Ложь;
		
