		ТаблицаЗаказов.Колонки.Добавить("methodPaymentOfLifting", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(1)));
		
		ТаблицаЗаказов.Колонки.Добавить("changeOfPaymentTypeDisabled", Новый ОписаниеТипов("Булево"));
		
		ТаблицаЗаказов.Колонки.Добавить("idRowOrder", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(3)));
		ТаблицаЗаказов.Колонки.Добавить("partnerID", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(9)));
		ТаблицаЗаказов.Колонки.Добавить("tripID", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(9)));
		ТаблицаЗаказов.Колонки.Добавить("requestLiftType", Новый ОписаниеТипов("Булево"));
		
		ТаблицаЗаказов.Колонки.Добавить("tariffZoneCode", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(11)));
		ТаблицаЗаказов.Колонки.Добавить("customerIdentificationCode", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(10)));
		
