			Для Каждого ТекРейс Из ДанныеВызова.arrayOfTrips Цикл
				НайденнаяСсылка = Справочники.Рейсы.НайтиПоРеквизиту("НомерРейса", ТекРейс.id);
				Если НайденнаяСсылка.Пустая() Тогда
					РейсОбъект = Справочники.Рейсы.СоздатьЭлемент();
				Иначе
					РейсОбъект = НайденнаяСсылка.ПолучитьОбъект();
				КонецЕсли;	
				
				
				РейсОбъект.НомерРейса = ТекРейс.id;
				РейсОбъект.ДатаРейса = ТекРейс.dateTrip;
				РейсОбъект.ДатаДокумента = ТекРейс.dateDocument;
