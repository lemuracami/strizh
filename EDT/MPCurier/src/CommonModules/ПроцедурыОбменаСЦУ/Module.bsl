			Возврат ОтветМетода;		
		КонецеСли;				
		
		
		Запрос = Новый Запрос();
		Запрос.Текст = "ВЫБРАТЬ
		|	ТоварыЗаказов.orderNumber КАК НомерЗаказа,
		|	ТоварыЗаказов.rowNumber КАК НомерСтроки,
		|	ТоварыЗаказов.code КАК КодТовара,
		|	ТоварыЗаказов.artikul КАК АртикулТовара,
		|	ТоварыЗаказов.name КАК Наименование,
		|	ТоварыЗаказов.count КАК Количество,
		|	ТоварыЗаказов.price КАК Цена,
		|	ТоварыЗаказов.summa КАК Сумма,
		|	ТоварыЗаказов.barcode КАК ШК,
		|	ТоварыЗаказов.markingCode КАК КМ,
		|	ТоварыЗаказов.idGoodSeller КАК КодПоставщика,
		|	ТоварыЗаказов.NDSRow КАК СтавкаНДС
		|ПОМЕСТИТЬ ВТ_ТоварыЗаказов
		|ИЗ
		|	&ТоварыЗаказов КАК ТоварыЗаказов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТоварыЗаказов.НомерЗаказа КАК НомерЗаказа,
		|	ВТ_ТоварыЗаказов.КодТовара КАК КодТовара,
		|	ВТ_ТоварыЗаказов.АртикулТовара КАК АртикулТовара,
		|	ВТ_ТоварыЗаказов.Наименование КАК Наименование,
		|	ВТ_ТоварыЗаказов.Количество КАК Количество,
