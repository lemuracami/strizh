		Если ДанныеВызова.Свойство("arrayOfOrders") Тогда	
			Для Каждого ТекЗаказ Из ДанныеВызова.arrayOfOrders Цикл
				СтрокаЗаказы = ТаблицаЗаказов.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаЗаказы, ТекЗаказ);
				Для Каждого ТекТовар Из ТекЗаказ.goods Цикл
					СтрокаТовары = ТаблицаТоваров.Добавить(); 
					ЗаполнитьЗначенияСвойств(СтрокаТовары, ТекТовар);
					СтрокаТовары.orderNumber = СтрокаЗаказы.number;										
				КонецЦикла;
					
				Для Каждого ТекРасчет Из ТекЗаказ.deliveryCostCalculations Цикл
					СтрокаРасчет = ТаблицаРасчетаСтоимостиДоставки.Добавить(); 
					ЗаполнитьЗначенияСвойств(СтрокаРасчет, ТекРасчет);		
					СтрокаРасчет.orderNumber = СтрокаЗаказы.number;								
				КонецЦикла;					
			КонецЦикла;
		Иначе
			ОтветМетода.Вставить("РезультатВызова", Ложь);
