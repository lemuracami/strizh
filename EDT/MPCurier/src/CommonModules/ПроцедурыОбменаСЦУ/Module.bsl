	Если ЗначениеЗаполнено(ТранспортМП) Тогда
		//@skip-check reading-attribute-from-database
		СтруктураВызова.Вставить("IDCar", Константы.ТранспортМП.Получить().Код);
	Иначе
		ОтветМетода.Вставить("РезультатВызова", Ложь);
