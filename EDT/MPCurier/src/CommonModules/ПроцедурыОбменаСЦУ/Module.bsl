		ДанныеВызова = ДанныеВызова.result;
		
		Если ВозниклаОшибка Тогда
			ОтветМетода.Вставить("РезультатВызова", Ложь);
			ОтветМетода.Вставить("ОписаниеОшибки", "Возникла ошибка при запросе getTrips!");
