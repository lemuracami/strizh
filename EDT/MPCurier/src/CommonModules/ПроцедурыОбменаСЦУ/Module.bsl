		ВыборкаЗаказов = Запрос.Выполнить().Выбрать();
		
		ТекущийНомерЗаказаТриггер = Неопределено;
		ТекущийЗаказ = Неопределено;
		
		КэшСозданныхТоваров = Новый ТаблицаЗначений;
		КэшСозданныхТоваров.Колонки.Добавить("КодТовара", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(11)));
		КэшСозданныхТоваров.Колонки.Добавить("Товар", Новый ОписаниеТипов("СправочникСсылка.Товары"));
		
		
		Пока ВыборкаЗаказов.Следующий() Цикл
			
			// работа с заказами
			Если ТекущийНомерЗаказаТриггер <> ВыборкаЗаказов.НомерЗаказа Тогда
				Если ТекущийНомерЗаказаТриггер <> Неопределено Тогда
					ТекущийЗаказ.Записать();
				КонецеСли;	
				Если ЗначениеЗаполнено(ВыборкаЗаказов.Заказ) Тогда
					ТекущийЗаказ = ВыборкаЗаказов.Заказ.ПолучитьОбъект();
				Иначе
					ТекущийЗаказ = Справочники.Заказы.СоздатьЭлемент();
				КонецЕсли;		
				ЗаполнитьЗначенияСвойств(ТекущийЗаказ, ВыборкаЗаказов);
				ТекущийЗаказ.Код = ВыборкаЗаказов.НомерЗаказа;
				ТекущийНомерЗаказаТриггер = ВыборкаЗаказов.НомерЗаказа;
			КонецЕсли;
			
			// работа с товарами заказа
			Если ЗначениеЗаполнено(ВыборкаЗаказов.Товар) Тогда
				ТекущийТовар = ВыборкаЗаказов.Товар.ПолучитьОбъект();
			Иначе
				//поиск в кэше
				СтруктураПоиска = Новый Структура ("КодТовара", ВыборкаЗаказов.КодТовара);
				НайденныеСтрокиВКэше = КэшСозданныхТоваров.НайтиСтроки(СтруктураПоиска);
				Если НайденныеСтрокиВКэше.Количество() = 1 Тогда
					ТекущийТовар = НайденныеСтрокиВКэше[0].Товар;
				Иначе
					ТекущийТовар = Справочники.Товары.СоздатьЭлемент();
					ЗаполнитьЗначенияСвойств(ТекущийТовар, ВыборкаЗаказов);
					ТекущийТовар.Код = ВыборкаЗаказов.КодТовара;
					ТекущийТовар.Записать();
					
					НоваяСтрокаКэшТоваров = КэшСозданныхТоваров.Добавить();
					НоваяСтрокаКэшТоваров.КодТовара = ВыборкаЗаказов.КодТовара;
					НоваяСтрокаКэшТоваров.Товар = ТекущийТовар.Ссылка;						
				КонецЕсли;	
			КонецЕсли;		
			
			НоваяСтрокаТовара = ТекущийЗаказ.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТовара, ВыборкаЗаказов);
			Если НоваяСтрокаТовара.Товар.Пустая() Тогда
				НоваяСтрокаТовара.Товар = ТекущийТовар.Ссылка;
			КонецеСли;
		КонецЦикла;	
		ТекущийЗаказ.Записать();
		ОтветМетода.Вставить("РезультатВызова", Истина);		
	Исключение
		ТОшибки = ОписаниеОшибки();
		ОбщегоНазначенияСервер.ЗаписатьОшибкуВЛог(ТОшибки);
		ОтветМетода.Вставить("РезультатВызова", Ложь);
		ОтветМетода.Вставить("ОписаниеОшибки", ТОшибки);
		Возврат ОтветМетода;		
	КонецПопытки;	
	Возврат ОтветМетода;
КонецФункции


