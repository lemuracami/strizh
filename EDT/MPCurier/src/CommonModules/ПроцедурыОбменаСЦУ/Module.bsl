				РейсОбъект.Экспедитор = Справочники.Экспедиторы.НайтиПоКоду(ТекРейс.forwarderId);
				
				РейсОбъект.НомерПалеты = ТекРейс.paletNumber;
				РейсОбъект.ПометкаУдаления = ТекРейс.deletionMark;
