#Область ПрограммныйИнтерфейс
// Проверить возможность автологина.
// 
// Возвращаемое значение:
//  Булево - Проверить возможность автологина
Функция ПроверитьВозможностьАвтологинаВМП() Экспорт
	Транспорт = Константы.ТранспортМП.Получить();
	Если Транспорт.Пустая() Тогда
		Возврат Ложь;
	КонецеСли;	
	
	АвтоЛогин = Константы.Автологин.Получить();
	Если Автологин Тогда
		Пароль = Константы.ПарольВходаВМП.Получить();
		СохраненныйПароль = Константы.СохраненныйПарольВходаВМП.Получить();
		ДатаСохраненияПароля = Константы.ДатаСохраненияПароляВходаВМП.Получить();
		ПериодХраненияПароля = Константы.ПериодХраненияПароляПриАвтологине.Получить();
		Если СохраненныйПароль = Пароль И ДатаСохраненияПароля + ПериодХраненияПароля*3600 > ТекущаяДатаСеанса() Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецеСли;	
	Иначе
		Возврат Ложь;	
	КонецеСли;	
КонецФункции

// Сохранить данные автологина.
// 
// Параметры:
//  Пароль - Строка - Пароль
Процедура СохранитьДанныеАвтологина(Пароль) Экспорт
	Если Константы.Автологин.Получить() Тогда
		Константы.СохраненныйПарольВходаВМП.Установить(Пароль);
		Константы.ДатаСохраненияПароляВходаВМП.Установить(ТекущаяДатаСеанса());
	КонецеСли;	
КонецПроцедуры	
#КонецОбласти