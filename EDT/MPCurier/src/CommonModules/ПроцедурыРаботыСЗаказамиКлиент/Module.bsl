// Сбор данных результата доставки после переноса или заезда по заказу.
// 
// Параметры:
//  ПараметрыСтатуса - Структура - Параметры статуса
// 
// Возвращаемое значение:
//  Обещание - Сбор данных результата доставки после переноса или заезда по заказу
Асинх Функция СборДанныхРезультатаДоставкиПослеПереносаИлиЗаездаПоЗаказуАсинх(ПараметрыСтатуса) Экспорт
	ДанныеЗаказа = ПроцедурыРаботыСЗаказамиВызовСервера.ПолучитьДанныеЗаказа(ПараметрыСтатуса.Заказ);
	ДанныеРезультатаДоставки = ПроцедурыРаботыСЗаказамиВызовСервера.ПолучитьДанныеРезультатаДоставки(ПараметрыСтатуса.РезультатДоставки);
	
	ДанныеПодъемаИПримерки = Новый Структура;
	
	Если ДанныеРезультатаДоставки.ЭтоЗаезд Тогда
		ДанныеПодъемаИПримерки = Ждать СобратьДанныеПодъемаИПримеркиАсинх(ДанныеЗаказа);
		Если ДанныеПодъемаИПримерки = Неопределено Тогда
			Возврат Неопределено;
		КонецеСли;					
	КонецеСли;
	Возврат ДанныеПодъемаИПримерки;
КонецФункции	

// Сбор данных результата доставки после ветки КИК.
// 
// Параметры:
//  ПараметрыСтатуса - Структура - Параметры статуса
Асинх Процедура СборДанныхПоложительногоРезультатаДоставкиАсинх(ПараметрыСтатуса) Экспорт
	ДанныеЗаказа = ПроцедурыРаботыСЗаказамиВызовСервера.ПолучитьДанныеЗаказа(ПараметрыСтатуса.Заказ);
	ДанныеРезультатаДоставки = ПроцедурыРаботыСЗаказамиВызовСервера.ПолучитьДанныеРезультатаДоставки(ПараметрыСтатуса.РезультатДоставки);
	
	Если ДанныеРезультатаДоставки.ЭтоДоставка Тогда
		ДанныеПодъемаИПримерки = Ждать СобратьДанныеПодъемаИПримеркиАсинх(ДанныеЗаказа);
		Если ДанныеПодъемаИПримерки = Неопределено Тогда
			Возврат;
		КонецеСли;	
	КонецеСли;
	БСПКлиент.ДополнитьСтруктуру(ПараметрыСтатуса, ДанныеПодъемаИПримерки);	
	ПоказатьОповещениеПользователя("Открываем форму доставки..");
	//TODO: собрали данные доставки, переходим к интерфейсу доставки
КонецПроцедуры	


// Получить структуру данные установки результата доставки.
// 
// Параметры:
//  Заказ - СправочникСсылка.Заказы - Заказ
//  Рейс - СправочникСсылка.Рейсы - Рейс
//  РезультатДоставки - СправочникСсылка.РезультатыДоставки - Результат доставки
//  ПричинаОтказаПереноса - СправочникСсылка.ПричиныОтказаПереноса, Неопределено - Причина отказа переноса
// 
// Возвращаемое значение:
//  Структура - Получить структуру данные установки результата доставки:
// * РезультатДоставки - СправочникСсылка.РезультатыДоставки
// * ПричинаОтказаПереноса - СправочникСсылка.ПричиныОтказаПереноса, Неопределено - Причина отказа переноса
// * Заказ - СправочникСсылка.Заказы
// * Рейс - СправочникСсылка.Рейсы
Функция ПолучитьСтруктуруДанныеУстановкиРезультатаДоставки(Заказ, Рейс, РезультатДоставки, ПричинаОтказаПереноса = Неопределено) Экспорт
	ПараметрыСтатуса = Новый Структура;
	ПараметрыСтатуса.Вставить("РезультатДоставки", РезультатДоставки);
	ПараметрыСтатуса.Вставить("ПричинаОтказаПереноса", ПричинаОтказаПереноса);
	ПараметрыСтатуса.Вставить("Заказ", Заказ);
	ПараметрыСтатуса.Вставить("Рейс", Рейс);
	
	Возврат ПараметрыСтатуса;
КонецФункции	
#КонецОбласти

