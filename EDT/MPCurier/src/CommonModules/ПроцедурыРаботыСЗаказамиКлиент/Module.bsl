// Получить список этажей.
// 
// Возвращаемое значение:
//  СписокЗначений из Число - Получить список этажей
Функция ПолучитьСписокЭтажей()
	СписокЭтажей = Новый СписокЗначений();
	Для СчетчикЭтажей = 1 По 40 Цикл
		СписокЭтажей.Добавить(СчетчикЭтажей, Строка(СчетчикЭтажей) + " эт.");
	КонецЦикла;	
	Возврат СписокЭтажей;
КонецФункции	

// Получить список результатов примерки.
// 
// Возвращаемое значение:
//  СписокЗначений из Булево - Заполнить список результатов примерки
Функция ПолучитьСписокРезультатовПримерки()
	СписокВидовПримерки = Новый СписокЗначений();
	СписокВидовПримерки.Добавить(Ложь, "Без примерки");
	СписокВидовПримерки.Добавить(Истина, "Примерка произведена");
	Возврат СписокВидовПримерки;
КонецФункции

// Собрать данные подъема асинх.
// 
// Параметры:
//  ДанныеЗаказа  - Структура - Данные заказа
// 
// Возвращаемое значение:
//  Обещание - Собрать данные подъема асинх
Асинх Функция СобратьДанныеПодъемаАсинх(ДанныеЗаказа)
	СтруктураОтвета = Новый Структура();
	
	Если ДанныеЗаказа.ЗапрашиватьДанныеПодъема Тогда
		СписокВидовПодъема =  ПроцедурыРаботыСЗаказамиВызовСервера.ПолучитьСписокВидовПодъемаНаЭтаж();
		ВыбранноеЗначениеВидПодъема = Ждать СписокВидовПодъема.ВыбратьЭлементАсинх("Укажите вид подъема..");
		Если ВыбранноеЗначениеВидПодъема <> Неопределено Тогда
			СтруктураОтвета.Вставить("ВидПодъема", ВыбранноеЗначениеВидПодъема.Значение);
			Если ВыбранноеЗначениеВидПодъема.Значение = ПредопределенноеЗначение("Перечисление.ВидыПодъемовЗаказаНаЭтаж.РучнойПодъем") Тогда
				СписокЭтажей = ПолучитьСписокЭтажей();
				ВыбранныйЭтаж = Ждать СписокЭтажей.ВыбратьЭлементАсинх("Выберите этаж...");
				Если ВыбранныйЭтаж <> Неопределено Тогда
					СтруктураОтвета.Вставить("ЭтажПодъема", ВыбранныйЭтаж.Значение);
				Иначе
					Возврат Неопределено;
				КонецеСли;	
			КонецеСли;
		Иначе
			Возврат Неопределено;
		КонецЕсли;			
	КонецеСли;		
//			TODO: установка ДанныеЗВ.ВесЗаказа был при выборе подъема, если ЭтоПодъем = истина			
//			Если ЭтоПодъем(ВыбП.Значение) Тогда
//				ФормаСтатуса.Объект.КоличествоХодокНаЭтаж = 1;
//				Если Не ЭтоДоставка Тогда
//					ФормаСтатуса.Объект.ВесЗаказа = ПолучитьВесЗаказа(ТекСтрока);
//				КонецеСли;	
//			КонецеСли;						

	Возврат СтруктураОтвета;
КонецФункции

// Собрать данные примерки.
// 
// Параметры:
//  ДанныеЗаказа  - Структура - Данные заказа
// 
// Возвращаемое значение:
//  Обещание - Собрать данные примерки
Асинх Функция СобратьДанныеПримеркиАсинх(ДанныеЗаказа)
	СтруктураОтвета = Новый Структура("БылаПроизведенаПримерка", Ложь);
	Если ДанныеЗаказа.УслугаПримерки Тогда
		СписокРезультатовПримерки = ПолучитьСписокРезультатовПримерки();
		ВыбранныйРезультатПримерки = Ждать СписокРезультатовПримерки.ВыбратьЭлементАсинх("Укажите результат примерки..");
		Если ВыбранныйРезультатПримерки <> Неопределено Тогда
			Если ВыбранныйРезультатПримерки.Значение Тогда
				СтруктураОтвета.Вставить("БылаПроизведенаПримерка", Истина);
				СтруктураОтвета.Вставить("КоличествоSKUПримерки", ДанныеЗаказа.ИтогоКоличествоТоваров);
			КонецеСли;	
		Иначе
			Возврат Неопределено;
		КонецеСли;	
	КонецеСли;
	Возврат СтруктураОтвета;
КонецФункции

// Собрать данные подъема и примерки.
// 
// Параметры:
//  ДанныеЗаказа - Структура - Данные заказа
// 
// Возвращаемое значение:
//  Обещание - Собрать данные подъема и примерки
Асинх Функция СобратьДанныеПодъемаИПримеркиАсинх(ДанныеЗаказа)
	ДанныеПодъема = Ждать СобратьДанныеПодъемаАсинх(ДанныеЗаказа);
	Если ДанныеПодъема = Неопределено Тогда
		Возврат Неопределено;
	КонецеСли;	
	ДанныеПримерки = Ждать СобратьДанныеПримеркиАсинх(ДанныеЗаказа);
	Если ДанныеПримерки = Неопределено Тогда
		Возврат Неопределено;
	КонецеСли;	
	БСПКлиент.ДополнитьСтруктуру(ДанныеПодъема, ДанныеПримерки);
	Возврат ДанныеПодъема;
КонецФункции
 
