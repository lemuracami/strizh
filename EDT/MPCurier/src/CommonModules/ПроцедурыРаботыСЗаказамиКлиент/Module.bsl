// Обработка оповещения установка даты переноса заказа.
// 
// Параметры:
//  Результат - Структура - Результат
//  ДополнительныеПараметры - Структура - Дополнительные параметры
Асинх Процедура ОбработкаОповещенияУстановкаДатыПереносаЗаказаАсинх(Результат, ДополнительныеПараметры) Экспорт
	Если Результат <> Неопределено Тогда
		Если Результат.РезультатВыполнения Тогда
			ДанныеПодъемаИПримерки = Ждать СборДанныхРезультатаДоставкиПослеПереносаИлиЗаездаПоЗаказуАсинх(Результат);
			Если ДанныеПодъемаИПримерки = Неопределено Тогда
				Возврат;
			КонецеСли;								
			БСПКлиент.ДополнитьСтруктуру(Результат, ДанныеПодъемаИПримерки);			
			ПроцедурыРаботыСЗаказамиВызовСервера.УстановитьСтатусДоставкиЗаказа(Результат);
			Оповестить("ИзмененСтатус");
		КонецеСли;	
	КонецеСли;	
КонецПроцедуры	


